{
    "name": "netresearch/typo3-demo",
    "description": "Netresearch TYPO3 Demo — reproducible, disposable TYPO3 14 showcase",
    "license": "GPL-2.0-or-later",
    "type": "project",
    "require": {
        "b13/ai-label": "^1.3",
        "bk2k/bootstrap-package": "^16.0",
        "causal/extractor": "^2.6",
        "cweagans/composer-patches": "^2.0",
        "friendsoftypo3/content-blocks": "^2.0",
        "georgringer/news": "^14.0",
        "guzzlehttp/guzzle": "^8.0",
        "lochmueller/index": "^3.0",
        "mfd/ai-filemetadata": "^1.6",
        "netresearch/contexts": "^5.0.4",
        "netresearch/nr-ai-search": "dev-main",
        "netresearch/nr-browser-ai": "^0.8.0",
        "netresearch/nr-bug-reporter": "^0.1.2",
        "netresearch/nr-image-sitemap": "^14.0.3",
        "netresearch/nr-landingpage": "^0.3.23",
        "netresearch/nr-llm": "^0.43.0",
        "netresearch/nr-llm-compat": "^0.4.3",
        "netresearch/nr-mcp-agent": "^0.29.0",
        "netresearch/nr-passkeys-be": "^1.0.3",
        "netresearch/nr-passkeys-fe": "^2.0.1",
        "netresearch/nr-repurpose": "^0.13.0",
        "netresearch/nr-scheduler": "^2.0.1",
        "netresearch/nr-temporal-cache": "^1.0.4",
        "netresearch/nr-textdb": "^4.1.0",
        "netresearch/nr-vault": "^1.2.0",
        "netresearch/rte-ckeditor-image": "^13.10.4",
        "netresearch/t3-cowriter": "^3.23.0",
        "netresearch/typo3-demo-site": "@dev",
        "t3g/analytics": "^1.0",
        "thieleundklose/autotranslate": "^3.2",
        "typo3/cms-backend": "^14.3",
        "typo3/cms-core": "^14.3",
        "typo3/cms-dashboard": "^14.3",
        "typo3/cms-extbase": "^14.3",
        "typo3/cms-extensionmanager": "^14.3",
        "typo3/cms-felogin": "^14.3",
        "typo3/cms-filelist": "^14.3",
        "typo3/cms-fluid": "^14.3",
        "typo3/cms-form": "^14.3",
        "typo3/cms-frontend": "^14.3",
        "typo3/cms-impexp": "^14.3",
        "typo3/cms-info": "^14.3",
        "typo3/cms-install": "^14.3",
        "typo3/cms-lowlevel": "^14.3",
        "typo3/cms-recycler": "^14.3",
        "typo3/cms-redirects": "^14.3",
        "typo3/cms-reports": "^14.3",
        "typo3/cms-rte-ckeditor": "^14.3",
        "typo3/cms-scheduler": "^14.3",
        "typo3/cms-seo": "^14.3",
        "typo3/cms-setup": "^14.3",
        "typo3/cms-tstemplate": "^14.3",
        "typo3/cms-workspaces": "^14.3"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "versions": {
                    "netresearch/typo3-demo-site": "1.0.0"
                }
            }
        },
        {
            "type": "vcs",
            "url": "https://git.netresearch.de/support/nr-ai-search.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/netresearch/t3x-nr-temporal-cache.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/netresearch/t3x-nr-bug-reporter.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/netresearch/t3x-rte_ckeditor_image.git"
        }
    ],
    "config": {
        "gitlab-domains": [
            "git.netresearch.de"
        ],
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true,
            "cweagans/composer-patches": true
        },
        "platform": {
            "php": "8.5"
        },
        "sort-packages": true
    },
    "extra": {
        "typo3/cms": {
            "web-dir": "public"
        },
        "patches": {
            "mfd/ai-filemetadata": {
                "Import ApplicationType from TYPO3\\CMS\\Core\\Http (1.6.3+ imports a class that does not exist) and generate alt texts on upload only in a backend request unless generateAltTextInFrontend is on, so CLI jobs that write images to FAL (nr_repurpose) no longer call the vision model; a failed generation is logged as a warning instead of failing the upload": "patches/mfd-ai-filemetadata-application-type.patch",
                "FalAdapter::localizeFile(): log DataHandler errors as a warning instead of DebuggerUtility::var_dump(), which wrote HTML into the AJAX upload response; the exception stays": "patches/mfd-ai-filemetadata-fal-adapter-log.patch"
            },
            "thieleundklose/autotranslate": {
                "Local translator hook: route translations through a container-resolved \\DeepL\\Translator subclass (nr-llm bridge) instead of the DeepL client": "patches/thieleundklose-autotranslate-translator-hook.patch"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
