{
    "name": "netresearch/typo3-demo",
    "description": "Netresearch TYPO3 Demo — reproducible, disposable TYPO3 14 showcase",
    "license": "GPL-2.0-or-later",
    "type": "project",
    "require": {
        "b13/ai-bots-love-markdown": "^0.6.1",
        "b13/ai-label": "^1.3",
        "bk2k/bootstrap-package": "^16.0",
        "brotkrueml/schema": "^4.4",
        "causal/extractor": "^2.6",
        "cweagans/composer-patches": "^2.0",
        "derhansen/sf_event_mgt": "^9.0",
        "friendsoftypo3/content-blocks": "^2.0",
        "friendsoftypo3/visual-editor": "^1.10.4",
        "georgringer/news": "^14.0",
        "guzzlehttp/guzzle": "^8.0",
        "in2code/sitescore": "^3.1",
        "lochmueller/index": "^3.0.1",
        "mfd/ai-filemetadata": "^1.6",
        "netresearch/contexts": "^5.1.1",
        "netresearch/falkenquell-site": "@dev",
        "netresearch/nr-ai-search": "dev-main",
        "netresearch/nr-browser-ai": "^0.9.0",
        "netresearch/nr-bug-reporter": "^0.1.2",
        "netresearch/nr-image-sitemap": "^14.0.3",
        "netresearch/nr-landingpage": "^0.7.0",
        "netresearch/nr-llm": "^0.46.0",
        "netresearch/nr-llm-compat": "^0.5.3",
        "netresearch/nr-mcp-agent": "^0.38.1",
        "netresearch/nr-passkeys-be": "^1.0.3",
        "netresearch/nr-passkeys-fe": "^2.0.1",
        "netresearch/nr-repurpose": "^0.15.3",
        "netresearch/nr-scheduler": "^2.0.1",
        "netresearch/nr-temporal-cache": "^1.0.4",
        "netresearch/nr-textdb": "^4.2.0",
        "netresearch/nr-vault": "^1.6.0",
        "netresearch/rte-ckeditor-image": "^13.10.5",
        "netresearch/t3-cowriter": "^3.28.3",
        "netresearch/typo3-demo-site": "@dev",
        "t3g/analytics": "^1.0",
        "thieleundklose/autotranslate": "^3.2",
        "typo3/cms-backend": "^14.3",
        "typo3/cms-beuser": "^14.3",
        "typo3/cms-core": "^14.3",
        "typo3/cms-dashboard": "^14.3",
        "typo3/cms-extbase": "^14.3",
        "typo3/cms-extensionmanager": "^14.3",
        "typo3/cms-felogin": "^14.3",
        "typo3/cms-filelist": "^14.3",
        "typo3/cms-fluid": "^14.3",
        "typo3/cms-form": "^14.3",
        "typo3/cms-frontend": "^14.3",
        "typo3/cms-impexp": "^14.3",
        "typo3/cms-info": "^14.3",
        "typo3/cms-install": "^14.3",
        "typo3/cms-lowlevel": "^14.3",
        "typo3/cms-recycler": "^14.3",
        "typo3/cms-redirects": "^14.3",
        "typo3/cms-reports": "^14.3",
        "typo3/cms-rte-ckeditor": "^14.3",
        "typo3/cms-scheduler": "^14.3",
        "typo3/cms-seo": "^14.3",
        "typo3/cms-setup": "^14.3",
        "typo3/cms-tstemplate": "^14.3",
        "typo3/cms-workspaces": "^14.3"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "versions": {
                    "netresearch/typo3-demo-site": "1.0.0",
                    "netresearch/falkenquell-site": "1.0.0"
                }
            }
        },
        {
            "type": "vcs",
            "url": "https://git.netresearch.de/support/nr-ai-search.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/netresearch/t3x-nr-temporal-cache.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/netresearch/t3x-nr-bug-reporter.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/netresearch/t3x-rte_ckeditor_image.git"
        }
    ],
    "config": {
        "gitlab-domains": [
            "git.netresearch.de"
        ],
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true,
            "cweagans/composer-patches": true
        },
        "platform": {
            "php": "8.5"
        },
        "sort-packages": true
    },
    "extra": {
        "typo3/cms": {
            "web-dir": "public"
        },
        "patches": {
            "b13/ai-label": {
                "Name typo3/fluid-styled-content as an optional set dependency: the hard one made TYPO3 log \"Invalid set b13/ai-label: Missing dependency\" on every boot of a site without fluid_styled_content": "patches/b13-ai-label-optional-fluid-styled-content.patch"
            },
            "lochmueller/index": {
                "Bootstrap Package indexing: read an item's or element's field only where the record's type has it; Record::get() throws for a field outside the type (a carousel item of type \"header\" has no bodytext, one of type \"image\" no subheader), and the throw dropped the whole page from the index": "patches/lochmueller-index-bootstrap-package-optional-fields.patch"
            },
            "mfd/ai-filemetadata": {
                "Import ApplicationType from TYPO3\\CMS\\Core\\Http (1.6.3+ imports a class that does not exist) and skip the frontend check when there is no request, as on the CLI; a failed generation is logged as a warning instead of failing the upload": "patches/mfd-ai-filemetadata-application-type.patch",
                "FalAdapter::localizeFile(): log DataHandler errors as a warning instead of DebuggerUtility::var_dump(), which wrote HTML into the AJAX upload response; the exception stays": "patches/mfd-ai-filemetadata-fal-adapter-log.patch"
            },
            "typo3/cms-backend": {
      "Element information of a record that does not exist (deleted, or a stale link) showed an info message for pages but threw a TypeError for every other table: getRecordWSOL() returns null and the controller's $row is typed array": "patches/typo3-cms-backend-element-information-missing-record.patch"
    },
    "thieleundklose/autotranslate": {
                "Setting translatorClass: a container-resolved \\DeepL\\Translator subclass translates instead of the DeepL client (upstream pull request 175, https://github.com/thieleundklose/tk-typo3-autotranslate/pull/175), so nr-llm's AutotranslateTranslator does the translating": "patches/thieleundklose-autotranslate-translator-class.patch",
            "Batch mode create_only: create missing translations and keep existing ones (upstream pull request 176, https://github.com/thieleundklose/tk-typo3-autotranslate/pull/176)": "patches/thieleundklose-autotranslate-create-only-mode.patch"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
