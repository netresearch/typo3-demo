# Server defaults for the hardened MariaDB image.
#
# The image ships no configuration file at all — neither /etc/my.cnf nor
# /etc/mysql/my.cnf — so the server runs on its built-in defaults and would
# create schema objects with MariaDB 12's utf8mb4_uca1400_ai_ci. Passing the
# settings as command arguments does not work either: the hardened entrypoint
# execs a fixed `mariadbd --datadir=...` and drops everything else. A file at
# /etc/my.cnf is the one channel the server itself still reads.
[mariadbd]
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci
