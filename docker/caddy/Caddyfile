{
	# The container healthcheck probes the admin API through `caddy reload`
	# (the hardened image carries no HTTP client). Without this the probe would
	# write three access-log lines per run — thousands a day for no information.
	# The admin endpoint listens on localhost only and nothing else uses it.
	log default {
		exclude admin.api
	}
}

{$TYPO3_DOMAIN:localhost} {
    reverse_proxy web:80 {
        # A deploy replaces the web container, and the new one accepts
        # connections only when its entrypoint is done (about 10-30s). Caddy
        # keeps dialling for up to a minute instead of answering 502: the
        # visitor waits, and nothing has been sent yet, so a retry of any
        # method is safe.
        lb_try_duration 60s
        lb_try_interval 250ms
        transport http {
            keepalive 30s
            keepalive_idle_conns 16
            read_timeout 120s
            write_timeout 120s
        }
    }
    encode zstd gzip
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
        -X-Powered-By
    }
    log {
        output stdout
        format json
    }
}
